# ==============================================================================
# COURSE PLATFORM FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Public Website URL (Required in production for canonical tags, sitemap.xml, robots.txt)
# Production example: NEXT_PUBLIC_SITE_URL=https://courses.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public API Base URL (Live production backend API)
NEXT_PUBLIC_API_BASE_URL=https://api.softmaxs.com

# Internal Backend URL for Server-Side Component (RSC) requests and Next.js rewrites
INTERNAL_BACKEND_URL=https://api.softmaxs.com

# Google Identity Services (GIS) / OAuth 2.0 Web Client ID (Public)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs (Web application).
# Authorized JavaScript Origins: http://localhost:3000 (dev), https://yourdomain.com (prod)
# If left as placeholder or unconfigured, the login page displays a runtime setup notice without breaking the build.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# WhatsApp Admissions Desk (format: country code + digits, e.g. 919876543210)
# Leave undefined if unconfigured; the frontend will display a configuration notice.
# NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# Admissions & Support Contact Information (Optional)
# Populates verified contact phone and support email in header, footer, and contact channels.
# When left undefined, contact rows are cleanly hidden without placeholder data.
# NEXT_PUBLIC_SUPPORT_EMAIL=admissions@example.com
# NEXT_PUBLIC_CONTACT_PHONE=+91 XXXXXXXXXX
